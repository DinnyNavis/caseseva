# CaseSeva AI - Frontend Environment Configuration
# Copy this file to .env.local to override the default API base URL.

# -----------------------------------------------------------------------------
# Configuration 1: Local Backend (FastAPI running locally on port 8000)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# Configuration 2: Deployed Live AWS Backend (API Gateway in ap-southeast-2)
# Uncomment the line below (and comment out Local Backend) to switch to AWS.
# -----------------------------------------------------------------------------
# VITE_API_BASE_URL=https://d9a7s8hbid.execute-api.ap-southeast-2.amazonaws.com
